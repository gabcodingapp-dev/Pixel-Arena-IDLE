{
  "name": "pixel-arena-idle",
  "version": "1.0.0",
  "private": true,
  "description": "Cozy pixel-art idle RPG \u2014 deploy heroes, expand territory, hoard gold.",
  "scripts": {
    "dev": "node tools/serve.js",
    "assets": "python3 tools/build_assets.py",
    "build:web": "node tools/build_web.js",
    "build:android": "node tools/build_web.js && node tools/sync_android.js",
    "apk": "npm run build:android && cd android && ./gradlew assembleDebug",
    "test": "node tools/simtest.js && node tools/harness.js",
    "test:logic": "node tools/simtest.js",
    "test:render": "node tools/harness.js"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "jsdom": "^25.0.1",
    "@napi-rs/canvas": "^0.1.65"
  }
}
